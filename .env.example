# Credentials for the existing Panta by Lanix Iligan GitHub App.
# In GitHub App settings, copy the Client ID (not the App ID).
GITHUB_APP_CLIENT_ID=
# Generate this under Client secrets and keep it only in your local .env.
GITHUB_APP_CLIENT_SECRET=
# Must exactly match a callback URL configured in the GitHub App.
GITHUB_CALLBACK_URL=http://localhost:5173/api/auth/github/callback
# Public app slug. The app also accepts the full GitHub App URL.
GITHUB_APP_SLUG=panta-by-lanix-iligan
